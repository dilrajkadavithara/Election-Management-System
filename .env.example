# ============================================================
# ElectraData — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# --- PostgreSQL Database ---
DB_NAME=voters_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-50-chars-min
DJANGO_SETTINGS_MODULE=voter_vault.settings

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-another-long-random-string
SECRET_KEY=election-super-secret-key-2026

# --- Allowed Origins (CORS) ---
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,https://intelhub.live

# --- Google Gemini AI (required for OCR extraction) ---
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# --- Redis (optional — used for session state & Celery queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery (set to true only if a Celery worker is also running) ---
# Leave as false for single-machine / local development setups.
# Set to true in docker-compose production deployments.
CELERY_ENABLED=false

# --- Document Processing Tool Paths (Windows local only — Linux uses system PATH) ---
POPPLER_PATH=C:\poppler\poppler-25.12.0\Library\bin
