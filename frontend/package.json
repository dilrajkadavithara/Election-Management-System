{
    "name": "voter-ocr-frontend",
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run --dir src",
        "test:e2e": "npx playwright test",
        "test:e2e:local": "npx playwright test e2e/rbac.spec.js e2e/modal.spec.js e2e/pwa.spec.js",
        "test:e2e:prod": "TEST_URL=https://intelhub.live npx playwright test e2e/production.spec.js",
        "test:all": "vitest run && npx playwright test"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "recharts": "^3.7.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "jsdom": "^28.1.0",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "vite": "^5.0.8",
        "vitest": "^4.0.18"
    }
}
